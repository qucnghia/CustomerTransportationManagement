# ==============================================================================
# Git Ignore for Transportation Management Project
# ==============================================================================

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# LaTeX build artifacts (chỉ giữ file .tex và .pdf hoàn thiện)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# Java & Spring Boot build files (cho các bước sau)
target/
*.class
*.jar
*.war
*.ear
.mvn/
mvnw
mvnw.cmd

# Node & ReactJS build files (cho các bước sau)
node_modules/
dist/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# MySQL temporary or backup files
*.dump
*.bak
